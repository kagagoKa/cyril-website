name: Auto Update Lotto JSON

on:
  schedule:
    - cron: "0 14 * * *"   # every day at 2PM UTC (adjust for PH time)
    - cron: "0 21 * * *"   # every day at 9PM UTC
  workflow_dispatch:        # allow manual trigger

jobs:
  update-json:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repo
        uses: actions/checkout@v3

      - name: Update lotto.json
        run: |
          # Replace this with a scraper later
          echo '{ "result": "XX-YY-ZZ", "date": "$(date +%Y-%m-%d)", "draw": "AUTO" }' > lotto.json

      - name: Commit changes
        run: |
          git config --global user.name "github-actions"
          git config --global user.email "actions@github.com"
          git add lotto.json
          git commit -m "Auto update lotto result"
          git push
