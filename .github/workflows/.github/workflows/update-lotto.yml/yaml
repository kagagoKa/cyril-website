name: Update Lotto JSON

on:
  schedule:
    - cron: "0 14 * * *"   # 2PM Philippine time
    - cron: "0 21 * * *"   # 9PM Philippine time
  workflow_dispatch:

jobs:
  update-json:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repo
        uses: actions/checkout@v3

      - name: Update lotto.json
        run: |
          echo '{ "result": "XX-YY-ZZ", "date": "$(date +%Y-%m-%d)", "draw": "2PM" }' > lotto.json

      - name: Commit changes
        run: |
          git config --global user.name "github-actions"
          git config --global user.email "actions@github.com"
          git add lotto.json
          git commit -m "Auto update lotto result"
          git push
