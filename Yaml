name: Update Lotto JSON

on:
  schedule:
    - cron: "0 14 * * *"   # every day at 2PM Philippine time
  workflow_dispatch:       # allow manual trigger

jobs:
  update-json:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repo
        uses: actions/checkout@v3

      - name: Update lotto.json
        run: |
          echo '{ "result": "12-23-45", "date": "2026-08-01", "draw": "9PM" }' > lotto.json

      - name: Commit changes
        run: |
          git config --global user.name "github-actions"
          git config --global user.email "actions@github.com"
          git add lotto.json
          git commit -m "Update lotto result"
          git push
